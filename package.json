{
  "name": "@aethor/studio-v2",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "pnpm --filter @aethor/studio-web dev",
    "preview": "pnpm --filter @aethor/studio-web preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "profile:verify": "node shared/robot-profiles/verify-provenance.mjs",
    "test:web": "pnpm profile:verify && pnpm -r --if-present test",
    "test": "pnpm test:web && pnpm gateway:test && pnpm desktop:test && pnpm desktop:legal:test",
    "build:web": "pnpm profile:verify && pnpm --filter @aethor/studio-web build",
    "build": "pnpm build:web && pnpm gateway:build:verify && pnpm desktop:build:verify",
    "test:e2e": "pnpm --filter @aethor/studio-web test:e2e",
    "gateway:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File services/robot-gateway/dotnet.ps1 restore services/robot-gateway/AethorStudioV2.RobotGateway.slnx",
    "gateway:build": "powershell -NoProfile -ExecutionPolicy Bypass -File services/robot-gateway/dotnet.ps1 build services/robot-gateway/AethorStudioV2.RobotGateway.slnx --configuration Release",
    "gateway:build:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File services/robot-gateway/dotnet-isolated.ps1 gateway build services/robot-gateway/AethorStudioV2.RobotGateway.slnx --configuration Release",
    "gateway:test": "powershell -NoProfile -ExecutionPolicy Bypass -File services/robot-gateway/dotnet-isolated.ps1 gateway test services/robot-gateway/AethorStudioV2.RobotGateway.slnx --configuration Release",
    "gateway:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File services/robot-gateway/preflight-readonly.ps1",
    "gateway:preflight:control": "powershell -NoProfile -ExecutionPolicy Bypass -File services/robot-gateway/preflight-control.ps1",
    "gateway:smoke:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File services/robot-gateway/smoke-offline.ps1",
    "gateway:soak:readonly": "powershell -NoProfile -ExecutionPolicy Bypass -File services/robot-gateway/soak-readonly.ps1",
    "gateway:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File services/robot-gateway/dotnet.ps1 run --project services/robot-gateway/src/AethorStudioV2.Api/AethorStudioV2.Api.csproj",
    "dev:engineering": "powershell -NoProfile -ExecutionPolicy Bypass -File services/robot-gateway/start-engineering-dev.ps1",
    "desktop:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File services/robot-gateway/dotnet.ps1 restore apps/studio-desktop/AethorStudioV2.Desktop.slnx",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File services/robot-gateway/dotnet.ps1 build apps/studio-desktop/AethorStudioV2.Desktop.slnx --configuration Release",
    "desktop:build:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File services/robot-gateway/dotnet-isolated.ps1 desktop build apps/studio-desktop/AethorStudioV2.Desktop.slnx --configuration Release",
    "desktop:test": "powershell -NoProfile -ExecutionPolicy Bypass -File services/robot-gateway/dotnet-isolated.ps1 desktop test apps/studio-desktop/AethorStudioV2.Desktop.slnx --configuration Release",
    "desktop:legal:test": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/studio-desktop/test-legal-inventory.ps1",
    "desktop:package": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/studio-desktop/build-windows.ps1",
    "desktop:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/studio-desktop/smoke-packaged.ps1",
    "desktop:dpi:evidence": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/studio-desktop/collect-dpi-evidence.ps1",
    "desktop:verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/studio-desktop/verify-release-candidate.ps1"
  }
}
