{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethor.local/contracts/gateway-contracts-v1.schema.json",
  "title": "Aethor Studio V2 Gateway Contracts V1",
  "$defs": {
    "DataSource": { "enum": ["showcase", "measured", "commanded", "computed", "unavailable"] },
    "Validity": { "enum": ["valid", "stale", "invalid", "unavailable"] },
    "RobotCommandKind": { "enum": ["enable", "stopAndDisable", "home", "reset", "setMode", "jointGroup"] },
    "CommandStatus": { "enum": ["unsupported", "rejected", "accepted", "completed", "failed", "timedOut", "cancelled", "unconfirmed"] },
    "CommandEvidence": { "enum": ["none", "gatewayAccepted", "transportWritten", "deviceQueued", "deviceAck", "feedbackConfirmed"] },
    "DirectCommandStatus": { "enum": ["sent", "replied", "rejected", "timedOut", "failed"] },
    "CommandResultCode": { "enum": ["ok", "commandsDisabled", "invalidRequest", "sessionMismatch", "notConnected", "feedbackStale", "motorNotEnabled", "invalidTarget", "speedUnverified", "speedOutOfRange", "safetyInterlockLatched", "commandInFlight", "commandIdConflict", "deviceRejected", "deviceUnconfirmed", "transportError", "timeout", "cancelled"] },
    "RobotSessionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "profileId", "connectionState", "motorState", "controlMode", "timestampUtc", "source", "validity"],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "profileId": { "type": "string", "minLength": 1 },
        "connectionState": { "enum": ["offline", "connecting", "connected", "reconnecting", "disconnecting", "faulted"] },
        "motorState": { "enum": ["unknown", "disabled", "enabled"] },
        "controlMode": { "oneOf": [{ "enum": [1, 2, 3] }, { "type": "null" }] },
        "timestampUtc": { "type": "string", "format": "date-time" },
        "source": { "$ref": "#/$defs/DataSource" },
        "validity": { "$ref": "#/$defs/Validity" }
      }
    },
    "SerialPortDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portName", "hardwareId", "displayName"],
      "properties": {
        "portName": { "type": "string", "pattern": "^COM[1-9][0-9]{0,3}$" },
        "hardwareId": { "type": ["string", "null"], "maxLength": 512 },
        "displayName": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "RobotConnectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portName", "profileId"],
      "properties": {
        "portName": { "type": "string", "pattern": "^COM[1-9][0-9]{0,3}$" },
        "profileId": { "const": "dummy-6dof" }
      }
    },
    "JointGroupCompletionPolicyV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positionToleranceDeg", "settledDurationMs", "timeoutMs"],
      "properties": {
        "positionToleranceDeg": { "type": "number", "minimum": 0.01, "maximum": 5 },
        "settledDurationMs": { "type": "integer", "minimum": 100, "maximum": 5000 },
        "timeoutMs": { "type": "integer", "minimum": 500, "maximum": 120000 }
      }
    },
    "RobotGatewayCapabilitiesV1": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "commandPolicy": { "const": "disabled" } }, "required": ["commandPolicy"] },
          "then": {
            "properties": {
              "hardwareCommands": { "const": false },
              "directCommand": { "const": false },
              "engineeringJointSpeedMaxDegS": { "type": "null" },
              "supportedCommands": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "commandPolicy": { "const": "supervised" } }, "required": ["commandPolicy"] },
          "then": { "properties": { "hardwareCommands": { "const": true }, "directCommand": { "const": false }, "engineeringJointSpeedMaxDegS": { "type": "null" } } }
        },
        {
          "if": { "properties": { "commandPolicy": { "const": "engineering" } }, "required": ["commandPolicy"] },
          "then": { "properties": { "hardwareCommands": { "const": true }, "directCommand": { "const": true }, "engineeringJointSpeedMaxDegS": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 } } }
        },
        {
          "if": {
            "properties": { "supportedCommands": { "type": "array", "contains": { "const": "jointGroup" } } },
            "required": ["supportedCommands"]
          },
          "then": {
            "properties": {
              "jointGroupSpeedLimitDegS": { "type": "number", "exclusiveMinimum": 0 },
              "jointGroupCompletion": { "$ref": "#/$defs/JointGroupCompletionPolicyV1" }
            }
          }
        },
        {
          "if": { "properties": { "jointGroupSpeedLimitDegS": { "type": "number" } }, "required": ["jointGroupSpeedLimitDegS"] },
          "then": { "properties": { "jointGroupCompletion": { "$ref": "#/$defs/JointGroupCompletionPolicyV1" } } }
        },
        {
          "if": { "properties": { "jointGroupCompletion": { "type": "object" } }, "required": ["jointGroupCompletion"] },
          "then": { "properties": { "jointGroupSpeedLimitDegS": { "type": "number", "exclusiveMinimum": 0 } } }
        }
      ],
      "required": ["contractVersion", "protocolAdapterId", "serialEnumeration", "readOnlyConnection", "liveTelemetry", "hardwareCommands", "directCommand", "commandPolicy", "allowedQueries", "supportedCommands", "jointGroupSpeedLimitDegS", "jointGroupCompletion", "engineeringJointSpeedMaxDegS"],
      "properties": {
        "contractVersion": { "const": "1.3" },
        "protocolAdapterId": { "const": "dummy-ascii-v1" },
        "serialEnumeration": { "type": "boolean" },
        "readOnlyConnection": { "type": "boolean" },
        "liveTelemetry": { "type": "boolean" },
        "hardwareCommands": { "type": "boolean" },
        "directCommand": { "type": "boolean" },
        "commandPolicy": { "enum": ["disabled", "supervised", "engineering"] },
        "allowedQueries": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["#GETJPOS", "#GETMODE", "#GETENABLE"] }
        },
        "supportedCommands": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/RobotCommandKind" }
        },
        "jointGroupSpeedLimitDegS": {
          "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }]
        },
        "jointGroupCompletion": {
          "oneOf": [{ "$ref": "#/$defs/JointGroupCompletionPolicyV1" }, { "type": "null" }]
        },
        "engineeringJointSpeedMaxDegS": {
          "oneOf": [{ "type": "number", "exclusiveMinimum": 0, "maximum": 100 }, { "type": "null" }]
        }
      }
    },
    "JointStateFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "profileId", "timestampUtc", "positionsDeg", "source", "validity"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "profileId": { "type": "string", "minLength": 1 },
        "timestampUtc": { "type": "string", "format": "date-time" },
        "positionsDeg": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "number" } },
        "source": { "$ref": "#/$defs/DataSource" },
        "validity": { "$ref": "#/$defs/Validity" }
      }
    },
    "JointGroupCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "sessionId", "profileId", "positionsDeg"],
      "properties": {
        "commandId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "profileId": { "const": "dummy-6dof" },
        "positionsDeg": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "number" } },
        "speedDegS": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "DirectCommandRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "sessionId", "profileId", "line"],
      "properties": {
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "profileId": { "const": "dummy-6dof" },
        "line": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[ -~]+$" }
      }
    },
    "DirectCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "sessionId", "status", "evidence", "normalizedLine", "message", "timestampUtc"],
      "properties": {
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "$ref": "#/$defs/DirectCommandStatus" },
        "evidence": { "$ref": "#/$defs/CommandEvidence" },
        "normalizedLine": { "type": "string", "maxLength": 255 },
        "message": { "type": "string", "maxLength": 500 },
        "timestampUtc": { "type": "string", "format": "date-time" },
        "deviceReply": { "type": ["string", "null"], "maxLength": 4096 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "sent" } }, "required": ["status"] },
          "then": {
            "properties": {
              "evidence": { "const": "transportWritten" },
              "deviceReply": { "type": "null" }
            }
          },
          "else": { "properties": { "evidence": { "not": { "const": "transportWritten" } } } }
        }
      ]
    },
    "SimpleRobotCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "sessionId", "profileId"],
      "properties": {
        "commandId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "profileId": { "const": "dummy-6dof" }
      }
    },
    "SetModeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "sessionId", "profileId", "mode"],
      "properties": {
        "commandId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "profileId": { "const": "dummy-6dof" },
        "mode": { "enum": [1, 2, 3] }
      }
    },
    "CommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "sessionId", "commandKind", "status", "code", "evidence", "message", "timestampUtc"],
      "properties": {
        "commandId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "commandKind": { "$ref": "#/$defs/RobotCommandKind" },
        "status": { "$ref": "#/$defs/CommandStatus" },
        "code": { "$ref": "#/$defs/CommandResultCode" },
        "evidence": { "$ref": "#/$defs/CommandEvidence" },
        "message": { "type": "string", "maxLength": 500 },
        "timestampUtc": { "type": "string", "format": "date-time" },
        "deviceReply": { "type": ["string", "null"], "maxLength": 4096 }
      }
    },
    "RobotCommandRequestSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "commandKind": { "enum": ["enable", "stopAndDisable", "home", "reset"] } }, "required": ["commandKind"] },
          "then": {
            "properties": {
              "mode": { "type": "null" },
              "positionsDeg": { "type": "null" },
              "positionsCount": { "type": "null" },
              "speedDegS": { "type": "null" },
              "payloadTruncated": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "commandKind": { "const": "setMode" } }, "required": ["commandKind"] },
          "then": {
            "properties": {
              "mode": { "type": "integer" },
              "positionsDeg": { "type": "null" },
              "positionsCount": { "type": "null" },
              "speedDegS": { "type": "null" },
              "payloadTruncated": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "commandKind": { "const": "jointGroup" } }, "required": ["commandKind"] },
          "then": { "properties": { "mode": { "type": "null" } } }
        },
        {
          "if": { "properties": { "positionsCount": { "type": "integer", "minimum": 7 } }, "required": ["positionsCount"] },
          "then": {
            "properties": {
              "positionsDeg": { "type": "array", "minItems": 6, "maxItems": 6 },
              "payloadTruncated": { "const": true }
            }
          }
        },
        {
          "if": { "properties": { "positionsCount": { "type": "integer", "maximum": 6 } }, "required": ["positionsCount"] },
          "then": { "properties": { "payloadTruncated": { "const": false } } }
        },
        {
          "if": { "properties": { "positionsCount": { "type": "null" } }, "required": ["positionsCount"] },
          "then": { "properties": { "positionsDeg": { "type": "null" }, "payloadTruncated": { "const": false } } }
        }
      ],
      "required": ["commandKind", "requestFingerprintSha256", "mode", "positionsDeg", "positionsCount", "speedDegS", "payloadTruncated"],
      "properties": {
        "commandKind": { "$ref": "#/$defs/RobotCommandKind" },
        "requestFingerprintSha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
        "mode": { "oneOf": [{ "type": "integer" }, { "type": "null" }] },
        "positionsDeg": {
          "oneOf": [
            { "type": "array", "maxItems": 6, "items": { "type": "number" } },
            { "type": "null" }
          ]
        },
        "positionsCount": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "speedDegS": { "oneOf": [{ "type": "number" }, { "type": "null" }] },
        "payloadTruncated": { "type": "boolean" }
      }
    },
    "CommandAuditRecord": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            { "properties": { "commandKind": { "const": "enable" }, "request": { "type": "object", "properties": { "commandKind": { "const": "enable" } } }, "result": { "type": "object", "properties": { "commandKind": { "const": "enable" } } } } },
            { "properties": { "commandKind": { "const": "stopAndDisable" }, "request": { "type": "object", "properties": { "commandKind": { "const": "stopAndDisable" } } }, "result": { "type": "object", "properties": { "commandKind": { "const": "stopAndDisable" } } } } },
            { "properties": { "commandKind": { "const": "home" }, "request": { "type": "object", "properties": { "commandKind": { "const": "home" } } }, "result": { "type": "object", "properties": { "commandKind": { "const": "home" } } } } },
            { "properties": { "commandKind": { "const": "reset" }, "request": { "type": "object", "properties": { "commandKind": { "const": "reset" } } }, "result": { "type": "object", "properties": { "commandKind": { "const": "reset" } } } } },
            { "properties": { "commandKind": { "const": "setMode" }, "request": { "type": "object", "properties": { "commandKind": { "const": "setMode" } } }, "result": { "type": "object", "properties": { "commandKind": { "const": "setMode" } } } } },
            { "properties": { "commandKind": { "const": "jointGroup" }, "request": { "type": "object", "properties": { "commandKind": { "const": "jointGroup" } } }, "result": { "type": "object", "properties": { "commandKind": { "const": "jointGroup" } } } } }
          ]
        }
      ],
      "required": ["commandId", "sessionId", "profileId", "commandKind", "acceptedAtUtc", "request", "transmittedPayloads", "transmissionLogTruncated", "result"],
      "properties": {
        "commandId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "profileId": { "const": "dummy-6dof" },
        "commandKind": { "$ref": "#/$defs/RobotCommandKind" },
        "acceptedAtUtc": { "type": "string", "format": "date-time" },
        "request": { "$ref": "#/$defs/RobotCommandRequestSnapshot" },
        "transmittedPayloads": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "transmissionLogTruncated": { "type": "boolean" },
        "result": { "$ref": "#/$defs/CommandResult" }
      }
    },
    "ProtocolFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timestampUtc", "direction", "raw", "parsedKind", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "timestampUtc": { "type": "string", "format": "date-time" },
        "direction": { "enum": ["tx", "rx", "error"] },
        "raw": { "type": "string", "maxLength": 4096 },
        "parsedKind": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/DataSource" },
        "correlationId": { "type": "string" }
      }
    },
    "SignalDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signalId", "displayName", "unit", "source", "color"],
      "properties": {
        "signalId": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "unit": { "enum": ["deg", "deg/s", "ms", "Hz"] },
        "source": { "$ref": "#/$defs/DataSource" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "dashed": { "type": "boolean" },
        "jointId": { "type": "string" }
      }
    },
    "SignalSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestampUtc", "value", "validity"],
      "properties": {
        "timestampUtc": { "type": "string", "format": "date-time" },
        "value": { "type": ["number", "null"] },
        "validity": { "$ref": "#/$defs/Validity" }
      }
    },
    "OperationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timestampUtc", "severity", "title", "detail", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "timestampUtc": { "type": "string", "format": "date-time" },
        "severity": { "enum": ["info", "warning", "error"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "detail": { "type": "string", "maxLength": 1000 },
        "source": { "$ref": "#/$defs/DataSource" }
      }
    },
    "DesktopBridgeCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "minimize", "toggleMaximize", "close", "exportDiagnostics"],
      "properties": {
        "available": { "type": "boolean" },
        "minimize": { "type": "boolean" },
        "toggleMaximize": { "type": "boolean" },
        "close": { "type": "boolean" },
        "exportDiagnostics": { "type": "boolean" }
      }
    },
    "DesktopBootstrapV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "gateway", "capabilities"],
      "properties": {
        "contractVersion": { "const": "1.0" },
        "gateway": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["baseUrl", "sessionToken"],
              "properties": {
                "baseUrl": { "type": "string", "pattern": "^https?://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:[0-9]{1,5})?$" },
                "sessionToken": { "type": "string", "minLength": 32, "maxLength": 256, "pattern": "^[!-~]+$" }
              }
            }
          ]
        },
        "capabilities": { "$ref": "#/$defs/DesktopBridgeCapabilities" }
      }
    },
    "DesktopBridgeRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "action"],
      "properties": {
        "contractVersion": { "const": "1.0" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "action": { "enum": ["minimize", "toggleMaximize", "close", "beginDrag", "exportDiagnostics"] }
      }
    },
    "DesktopBridgeResponseV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "ok"],
      "properties": {
        "contractVersion": { "const": "1.0" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ok": { "type": "boolean" },
        "errorCode": { "enum": ["unsupported", "invalidRequest", "hostFailure"] }
      }
    }
  }
}
